# Keep deterministic generated documentation identical on Windows and Linux.
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Reference icons retain the exact bytes of the Studio source assets.
assets/function-icons/** -text -whitespace

# Imported corpus and declared dependencies retain their exact source bytes,
# including on Windows checkouts. Their hashes are checked by the exporter.
assets/examples/** -text -whitespace
